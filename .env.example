# Copy this file to `.env` and fill in your real values.
# The .env file is gitignored and never committed.

# --- Anthropic (caption generation) ---
ANTHROPIC_API_KEY=your_key_here

# --- Facebook Page (publishing + engagement sync) ---
# A long-lived Page access token with permission to publish to the Page, and the
# numeric Page id.
FACEBOOK_PAGE_ACCESS_TOKEN=your_page_access_token_here
FACEBOOK_PAGE_ID=your_page_id_here

# --- Airtable (post + engagement logging, the self-learning loop) ---
# AIRTABLE_API_KEY: a Personal Access Token (starts with "pat...") with
#   data.records:read and data.records:write scopes on the base below.
# AIRTABLE_BASE_ID: the base id (starts with "app...") - find it in the Airtable
#   API docs for your base, or in the base URL.
AIRTABLE_API_KEY=your_airtable_pat_here
AIRTABLE_BASE_ID=your_airtable_base_id_here

# Optional overrides if your Airtable table/column names differ from the
# defaults (the base was AI-assisted, so names may have been changed). Leave
# these unset to use the defaults shown.
#   AIRTABLE_POSTS_TABLE=Posts
#   AIRTABLE_ENGAGEMENT_TABLE=Engagement
#   AIRTABLE_FIELD_TEMPLATE_ID=Template ID
#   AIRTABLE_FIELD_STYLE_TAG=Style Tag
#   AIRTABLE_FIELD_CAPTION=Caption
#   AIRTABLE_FIELD_FACEBOOK_POST_ID=Facebook Post ID
#   AIRTABLE_FIELD_TRACKING_ID=Tracking ID
#   AIRTABLE_FIELD_POST_LINK=Post
#   AIRTABLE_FIELD_CLICKS=Clicks
#   AIRTABLE_FIELD_LIKES=Likes
#   AIRTABLE_FIELD_COMMENTS=Comments
#   AIRTABLE_FIELD_LISTING_ROW_INDEX=Listing Row Index

# REQUIRED for the auto-ready listings flow (/auto-create-post): add a Number
# column named "Listing Row Index" to the Posts table (or set the override
# above to an existing column name). Without it, Airtable silently drops the
# field on write (same defensive behaviour as every other field here), and
# "next un-posted listing" tracking has nothing durable to read back.

# --- /sync-engagement auth ---
# Shared secret the caller (e.g. Make.com) must send as the X-Sync-Secret
# header. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SYNC_ENGAGEMENT_SECRET=your_shared_secret_here

# --- /internal-dashboard auth ---
# Shared secret gating the internal, read-only sales-flow dashboard. Send it as
# the X-Internal-Secret header, or open /internal-dashboard?secret=... in a
# browser (the login form does this for you). Unset means the dashboard is
# disabled and returns 503 - it never falls open.
INTERNAL_DASHBOARD_SECRET=your_internal_dashboard_secret_here

# Optional overrides for the Leads columns the dashboard reads. The first three
# are read-only there: Lead ID is Airtable's autonumber and Name/Contact are
# only ever filled in by a human.
#   AIRTABLE_LEADS_TABLE=Leads
#   AIRTABLE_FIELD_LEAD_ID=Lead ID
#   AIRTABLE_FIELD_LEAD_NAME=Name
#   AIRTABLE_FIELD_LEAD_CONTACT=Contact
#   AIRTABLE_FIELD_LEAD_TRACKING_ID=Tracking ID
#   AIRTABLE_FIELD_LEAD_LISTING=Interested Listing
#   AIRTABLE_FIELD_LEAD_SOURCE=Source
#   AIRTABLE_FIELD_LEAD_STATUS=Status
#   AIRTABLE_FIELD_LEAD_BUDGET=Budget Signal
#   AIRTABLE_FIELD_LEAD_TIMELINE=Timeline Signal
#   AIRTABLE_FIELD_LEAD_TRANSCRIPT=Transcript

# --- fal.ai (AI-simulated lighting/weather toggle) ---
# API key for fal.ai's Nano Banana 2 Edit model, used by /toggle-photo-condition
# to generate the 3x3 time-of-day x weather variants. Budget note: at $0.08 per
# image (1K resolution) and a 10-photo pool x 9 combos worst case EVER (each
# combo is generated at most once - see the Airtable cache table below), total
# spend is capped around $7.20, safely under a $10 ceiling. A cache hit costs
# nothing.
FAL_API_KEY=your_fal_api_key_here

# Optional overrides for the Airtable "Photo Condition Cache" table/columns -
# same pattern as the AIRTABLE_FIELD_* overrides above. Leave unset to use the
# defaults shown.
#   AIRTABLE_PHOTO_CACHE_TABLE=Photo Condition Cache
#   AIRTABLE_FIELD_PHOTO_FILENAME=Photo Filename
#   AIRTABLE_FIELD_TIME_OF_DAY=Time Of Day
#   AIRTABLE_FIELD_WEATHER=Weather
#   AIRTABLE_FIELD_EDITED_IMAGE=Edited Image
#
# REQUIRED: create a "Photo Condition Cache" table in your Airtable base with:
#   - Photo Filename  (Single line text)
#   - Time Of Day     (Single select: morning / evening / night)
#   - Weather         (Single select: sunny / cloudy / rainy)
#   - Edited Image    (Attachment)
# Without it, /toggle-photo-condition returns a clean 502 on every call (same
# defensive AirtableError behaviour as every other table in this app).

# --- Public base URL of THIS server (for tracking links) ---
# Used to build the /t/{tracking_id} link appended to each post's CTA.
# Locally the default (http://localhost:8000) is correct and you can leave this
# unset. IN PRODUCTION ON RAILWAY, set this to your app's public domain, e.g.
#   BASE_URL=https://propvibe-production.up.railway.app
# so the link a lead clicks resolves back to this server. No trailing slash.
BASE_URL=http://localhost:8000
