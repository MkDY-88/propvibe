# Copy this file to `.env` and fill in your real values.
# The .env file is gitignored and never committed.

# --- Anthropic (caption generation) ---
ANTHROPIC_API_KEY=your_key_here

# --- Facebook Page (publishing + engagement sync) ---
# A long-lived Page access token with permission to publish to the Page, and the
# numeric Page id.
FACEBOOK_PAGE_ACCESS_TOKEN=your_page_access_token_here
FACEBOOK_PAGE_ID=your_page_id_here

# --- Airtable (post + engagement logging, the self-learning loop) ---
# AIRTABLE_API_KEY: a Personal Access Token (starts with "pat...") with
#   data.records:read and data.records:write scopes on the base below.
# AIRTABLE_BASE_ID: the base id (starts with "app...") - find it in the Airtable
#   API docs for your base, or in the base URL.
AIRTABLE_API_KEY=your_airtable_pat_here
AIRTABLE_BASE_ID=your_airtable_base_id_here

# Optional overrides if your Airtable table/column names differ from the
# defaults (the base was AI-assisted, so names may have been changed). Leave
# these unset to use the defaults shown.
#   AIRTABLE_POSTS_TABLE=Posts
#   AIRTABLE_ENGAGEMENT_TABLE=Engagement
#   AIRTABLE_FIELD_TEMPLATE_ID=Template ID
#   AIRTABLE_FIELD_STYLE_TAG=Style Tag
#   AIRTABLE_FIELD_CAPTION=Caption
#   AIRTABLE_FIELD_FACEBOOK_POST_ID=Facebook Post ID
#   AIRTABLE_FIELD_TRACKING_ID=Tracking ID
#   AIRTABLE_FIELD_POST_LINK=Post
#   AIRTABLE_FIELD_CLICKS=Clicks
#   AIRTABLE_FIELD_LIKES=Likes
#   AIRTABLE_FIELD_COMMENTS=Comments
#   AIRTABLE_FIELD_LISTING_ROW_INDEX=Listing Row Index

# REQUIRED for the auto-ready listings flow (/auto-create-post): add a Number
# column named "Listing Row Index" to the Posts table (or set the override
# above to an existing column name). Without it, Airtable silently drops the
# field on write (same defensive behaviour as every other field here), and
# "next un-posted listing" tracking has nothing durable to read back.

# --- /sync-engagement auth ---
# Shared secret the caller (e.g. Make.com) must send as the X-Sync-Secret
# header. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SYNC_ENGAGEMENT_SECRET=your_shared_secret_here

# --- Public base URL of THIS server (for tracking links) ---
# Used to build the /t/{tracking_id} link appended to each post's CTA.
# Locally the default (http://localhost:8000) is correct and you can leave this
# unset. IN PRODUCTION ON RAILWAY, set this to your app's public domain, e.g.
#   BASE_URL=https://propvibe-production.up.railway.app
# so the link a lead clicks resolves back to this server. No trailing slash.
BASE_URL=http://localhost:8000
